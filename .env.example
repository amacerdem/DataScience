# Copy to .env and fill in. .env is gitignored.

# ─── Anthropic Claude (NL→T-SQL katmanı) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
# claude-opus-4-7   → en yüksek kalite, kompleks sorular için (önerilen)
# claude-haiku-4-5  → hızlı, ucuz, basit sorular için
ANTHROPIC_MODEL=claude-opus-4-7

# ─── Microsoft SQL Server (Docker container, lokal) ───────────────────
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=ChangeMeBeforeRun!
MSSQL_DATABASE=olist

# ─── Backend selector for nl2sql.py ───────────────────────────────────
# "mssql" (default — Microsoft SQL Server / Azure SQL / Fabric SQL endpoint)
# "duckdb" (legacy lokal Parquet prototip)
SQL_BACKEND=mssql
